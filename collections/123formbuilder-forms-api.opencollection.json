                "name": "payed",
                "value": "",
                "type": "query",
                "description": "Payment status. Possible values 0 - no, 1 - payed, 2 - invoiced, 3 - pending, 4 - declined, yes,  no, payed, invoced, pending, declined"
              },
              {
                "name": "approved",
                "value": "",
                "type": "query",
                "description": "Approval status. Possible values: 0 (N/A), 1 (Approved), 2 (Rejected)"
              }
            ]
