{
  "opencollection": "1.0.0",
  "info": {
    "name": "123FormBuilder REST API v2 Accounts Forms API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "JWT",
      "value": "{{JWT}}",
      "placement": "query"
    }
  },
