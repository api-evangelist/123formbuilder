          "http": {
            "method": "GET",
            "url": "https://api.123formbuilder.com/v2/forms/:form_id/submissions",
            "params": [
              {
                "name": "JWT",
                "value": "",
                "type": "query",
                "description": "JWT authentication token"
              },
              {
                "name": "form_id",
                "value": "",
                "type": "path",
                "description": "The ID of the form"
              },
              {
                "name": "start_date",
                "value": "",
