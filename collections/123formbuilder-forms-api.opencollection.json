          "http": {
            "method": "GET",
            "url": "https://api.123formbuilder.com/v2/forms/:form_id/fields",
            "params": [
              {
                "name": "JWT",
                "value": "",
                "type": "query",
                "description": "JWT authentication token"
              },
              {
                "name": "form_id",
                "value": "",
                "type": "path",
                "description": "The ID of the form"
              }
            ]
          },
